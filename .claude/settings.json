{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format*)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npx vitest*)",
      "Bash(npx prisma generate)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh issue view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm install*)",
      "Bash(npx prisma migrate*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.*.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Edit(./src/generated/**)",
      "Bash(git push --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)"
    ]
  }
}
